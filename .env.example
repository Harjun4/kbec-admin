PORT=3000
NODE_ENV=development

# Database Settings (MySQL or PostgreSQL)
DB_TYPE=postgres

# PostgreSQL / Supabase Direct Connection
SUPABASE_DB_HOST=db.ariqvrsvwvtwkllybqeb.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_db_password_here
SUPABASE_DB_NAME=postgres

# Supabase API Settings
SUPABASE_URL=https://ariqvrsvwvtwkllybqeb.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Local MySQL Fallback Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kbec_db

# Security & JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h
PASSWORD_SALT=your_password_salt_here

# Optional: Run database seed on startup (default: false)
SEED_ON_STARTUP=false
